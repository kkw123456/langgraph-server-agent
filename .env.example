# ===== LLM 配置（OpenAI 兼容接口）=====
# 支持任意 OpenAI 兼容服务：OpenAI / DeepSeek / Moonshot / 本地 Ollama 等
OPENAI_API_KEY=sk-xxx

# 方式一：OpenAI 官方（需要可访问 api.openai.com）
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# 方式二：DeepSeek（OpenAI 兼容，国内可直连，将下方两行取消注释即可）
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# 方式三：火山引擎 Ark（OpenAI 兼容，注意 BASE_URL 用 /api/plan/v1，非 /api/v3）
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v1
# MODEL=ark-code-latest

TEMPERATURE=0.3

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
DATA_DIR=data

# ===== 登录认证（可选）=====
# 同时配置用户名与密码才启用登录校验；留空则关闭（本地开发方便）。
# 令牌签名密钥 AUTH_SECRET 不配也行：会自动生成并持久化到 DATA_DIR/.auth_secret
AUTH_USERNAME=
AUTH_PASSWORD=
# 若通过 HTTPS 对外服务，建议开启（Cookie 加 Secure 标记）
AUTH_COOKIE_SECURE=false
